rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────
    // These are evaluated per-request; Firestore caches the get() result
    // within a single rule evaluation so multiple calls are not extra reads.

    function userRef() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDocExists() {
      return request.auth != null && exists(userRef());
    }

    function userDoc() {
      return get(userRef()).data;
    }

    function isAdmin() {
      return request.auth != null
        && userDocExists()
        && userDoc().role == 'admin'
        && userDoc().active != false;
    }

    function isActiveStaff() {
      return request.auth != null
        && userDocExists()
        && userDoc().role == 'staff'
        && userDoc().active != false;
    }

    // Any non-deactivated authenticated user (admin OR staff)
    function isActiveUser() {
      return isAdmin() || isActiveStaff();
    }

    // Student self-service session — a custom-token Firebase Auth identity
    // (minted by the studentLogin Cloud Function) carrying a `student` claim
    // plus either `regNumber` (normal case) or `studentDocId` (pending-admission
    // fallback, before a reg number has been allotted). See functions/src/index.ts.
    function isStudentClaim() {
      return request.auth != null && request.auth.token.student == true;
    }

    function isOwnStudentDoc(studentId, data) {
      return isStudentClaim() && (
        (request.auth.token.regNumber is string && data.regNumber == request.auth.token.regNumber) ||
        (request.auth.token.studentDocId is string && studentId == request.auth.token.studentDocId)
      );
    }

    // For collections keyed by studentId (not regNumber directly) — cross-check
    // the referenced student doc's regNumber against the caller's claim.
    function isOwnStudentRef(studentId) {
      return isStudentClaim()
        && exists(/databases/$(database)/documents/students/$(studentId))
        && get(/databases/$(database)/documents/students/$(studentId)).data.regNumber == request.auth.token.regNumber;
    }

    // ── Users ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Users read their own doc; admins read all (for staff list)
      allow read: if request.auth != null && (
        request.auth.uid == userId || isAdmin()
      );
      // First-time admin self-bootstrap (no doc yet → create own doc)
      allow create: if request.auth != null
        && request.auth.uid == userId
        && !exists(userRef());
      // Only active admins can write user docs (create/update staff accounts)
      allow write: if isAdmin();
    }

    // ── Settings ──────────────────────────────────────────────────────────
    match /settings/{settingId} {
      allow read:  if isActiveUser();
      allow write: if isAdmin();
    }

    // ── Students ──────────────────────────────────────────────────────────
    match /students/{studentId} {
      allow read:   if isActiveUser() || isOwnStudentDoc(studentId, resource.data);
      // Both admin and active staff can enroll (create/update) students
      allow create: if isActiveUser()
        && request.resource.data.keys().hasAll([
             'studentNameSSLC', 'course', 'academicYear',
             'meritNumber', 'regNumber'
           ]);
      allow update: if isActiveUser();
      // Only admins can permanently delete a student record
      allow delete: if isAdmin();
    }

    // ── Fee Structure ─────────────────────────────────────────────────────
    match /feeStructure/{structureId} {
      allow read: if isActiveUser() || isStudentClaim();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
             'academicYear', 'course', 'smp', 'svk'
           ]);
      allow update, delete: if isAdmin();
    }

    // ── Fee Records ───────────────────────────────────────────────────────
    match /feeRecords/{recordId} {
      allow read: if isActiveUser()
        || (isStudentClaim() && resource.data.regNumber == request.auth.token.regNumber);
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
             'studentId', 'academicYear', 'smp', 'svk', 'date'
           ]);
      allow update, delete: if isAdmin();
    }

    // ── Fine Schedules ────────────────────────────────────────────────────
    match /fineSchedules/{yearId} {
      allow read:  if isActiveUser();
      allow write: if isAdmin();
    }

    // ── Student Documents ─────────────────────────────────────────────────
    // Physical-document checklist. Admin and staff can both track status, but:
    //  - every changed entry must be well-formed (returned ⇒ received, bounded remark),
    //  - the writer must stamp their own email (admins exempt, for backup restore),
    //  - only admins can delete a record (student delete / Danger Zone reset).
    // Each change also writes an append-only audit entry under history/.
    function docKeys() {
      return ['sslcMarksCard', 'transferCertificate', 'studyCertificate', 'casteCertificate',
              'incomeCertificate', 'aadharCopy', 'eligibilityCertificate', 'passportPhotos'];
    }

    function validDocEntry(e) {
      return e is map
        && e.submitted is bool && e.returned is bool
        && (e.returned == false || e.submitted == true)
        && e.submittedOn is string && e.submittedOn.size() <= 10
        && e.returnedOn is string && e.returnedOn.size() <= 10
        && e.remarks is string && e.remarks.size() <= 500
        && (!('notRequired' in e) || e.notRequired is bool)
        && (!('copyType' in e) || e.copyType in ['original', 'copy']);
    }

    function changedDocKeys() {
      return resource == null
        ? request.resource.data.docs.keys().toSet()
        : request.resource.data.docs.diff(resource.data.docs).affectedKeys();
    }

    function docEntryOk(k) {
      return !(k in changedDocKeys()) || validDocEntry(request.resource.data.docs[k]);
    }

    // Only what a write CHANGES is checked, so legacy data already in a record
    // (e.g. retired doc types characterConduct / physicalFitness from the first
    // version, or extra top-level fields) never blocks a new, valid change.
    function validChecklist(studentId) {
      let d = request.resource.data;
      return d.docs is map
        && (resource == null
              ? (d.keys().hasOnly(['studentId', 'docs', 'updatedAt', 'updatedBy']) && d.studentId == studentId)
              : (d.diff(resource.data).affectedKeys().hasOnly(['docs', 'updatedAt', 'updatedBy'])
                 && d.docs.keys().hasAll(resource.data.docs.keys())))
        && changedDocKeys().hasOnly(docKeys())
        && docEntryOk('sslcMarksCard')
        && docEntryOk('transferCertificate')
        && docEntryOk('studyCertificate')
        && docEntryOk('casteCertificate')
        && docEntryOk('incomeCertificate')
        && docEntryOk('aadharCopy')
        && docEntryOk('eligibilityCertificate')
        && docEntryOk('passportPhotos');
    }

    match /studentDocuments/{studentId} {
      allow read:  if isActiveUser();
      allow create, update: if isActiveUser()
        && validChecklist(studentId)
        && (isAdmin() || (
          request.resource.data.updatedBy == request.auth.token.email
          && exists(/databases/$(database)/documents/students/$(studentId))
        ));
      allow delete: if isAdmin();

      // Append-only audit trail — nobody can edit an entry; only admins may delete
      // (cascade on student delete / Danger Zone reset).
      match /history/{entryId} {
        allow read:   if isActiveUser();
        allow create: if isActiveUser()
          && request.resource.data.keys().hasAll(['docKey', 'action', 'before', 'after', 'byUid', 'byEmail', 'at'])
          && request.resource.data.docKey in docKeys()
          && (isAdmin() || (
            request.resource.data.byUid == request.auth.uid
            && request.resource.data.byEmail == request.auth.token.email
            && existsAfter(/databases/$(database)/documents/studentDocuments/$(studentId))
          ));
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ── Student Files (scanned letters / documents, Files tab) ────────────
    // Metadata only — the file itself lives in Storage at studentFiles/{fileId}/…
    match /studentFiles/{fileId} {
      allow read:   if isActiveUser();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['ownerKey', 'studentId', 'storagePath', 'url']);
      allow update, delete: if isAdmin();
    }

    // ── Exam Fee Records ──────────────────────────────────────────────────
    match /examFeeRecords/{recordId} {
      allow read:  if isActiveUser();
      allow write: if isAdmin();
    }

    // ── Counters ──────────────────────────────────────────────────────────
    // Merit/reg number counters — written during enrollment transactions.
    // Both admin and staff can enroll, so both need write access here.
    match /counters/{counterId} {
      allow read:  if isActiveUser();
      allow write: if isActiveUser();
    }

    // ── Receipt Number Counters ───────────────────────────────────────────
    // One document per academic year tracks the highest SMP/SVK/Additional
    // receipt number issued. Written inside Firestore transactions to guarantee
    // uniqueness under concurrent fee collection by multiple staff users.
    match /receiptCounters/{academicYear} {
      allow read:  if isActiveUser();
      allow write: if isActiveUser();
    }

    // ── Inquiries ─────────────────────────────────────────────────────────
    match /inquiries/{inquiryId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
        && request.resource.data.keys().hasAll(['studentName', 'academicYear', 'status'])
        && request.resource.data.keys().hasAny(['mobile', 'parentMobile']);
      allow update: if isActiveUser();
      // Only admins can delete inquiries
      allow delete: if isAdmin();
    }

    // ── Fee Overrides ─────────────────────────────────────────────────────
    match /feeOverrides/{overrideId} {
      // resource is null when the override doc doesn't exist (the common case —
      // most students have no override); only enforce ownership when data exists.
      allow read: if isActiveUser()
        || (isStudentClaim() && (resource == null || isOwnStudentRef(resource.data.studentId)));
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll([
             'studentId', 'academicYear', 'smp', 'svk'
           ]);
      allow delete: if isAdmin();
    }

    // ── SNQ Fee Refunds ───────────────────────────────────────────────────
    match /refunds/{refundId} {
      allow read: if isActiveUser()
        || (isStudentClaim() && resource.data.regNumber == request.auth.token.regNumber);
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
             'studentId', 'academicYear', 'refundAmount', 'paymentType', 'paymentDate'
           ]);
      // Board Corrections keeps the student's identity copies in step. Amounts and
      // payment details stay immutable.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['regNumber', 'studentName', 'fatherName', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // ── Board Corrections runs (Settings › Import) ────────────────────────
    // One doc per run plus items/{studentDocId} holding before/after values, used
    // for undo. Student details inside, so admin only.
    match /boardCorrectionRuns/{document=**} {
      allow read, write: if isAdmin();
    }

    // ── Public meta (pre-aggregated stats readable by anyone) ────────────
    // Only the publicStats document lives here; written by authenticated users,
    // read publicly so the login screen can display enrollment statistics.
    match /meta/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Admin Config (API keys, SMS config, etc.) ─────────────────────────
    match /adminConfig/{docId} {
      allow read, write: if isAdmin();
    }

    // ── App Config (Play Store release version info) ──────────────────────
    // Read by the student mobile app (subscribeToAppConfig) to show the
    // update pill/notification; written by admins via Settings → App Version
    // (or the checkPlayStoreRelease Cloud Function via the Admin SDK, which
    // bypasses rules entirely).
    match /appConfig/{docId} {
      // tabHeaders / categoryIcons hold nothing but AI-image download URLs
      // (no student data). They're readable pre-auth so the student app can
      // start downloading those images while the Login screen is still up,
      // instead of after sign-in — see the app's warmPublicPortalImages().
      allow read: if docId in ['tabHeaders', 'categoryIcons']
        || isActiveUser() || isStudentClaim();
      allow write: if isAdmin();
    }

    // ── App Config (CCC counter, etc.) ────────────────────────────────────
    // Active users need read+write so certificate number transactions work.
    match /config/{docId} {
      allow read:  if isActiveUser();
      allow write: if isActiveUser();
    }

    // ── Merit List Snapshots ──────────────────────────────────────────────
    match /meritListSnapshots/{snapshotId} {
      allow read:  if isActiveUser();
      allow write: if isAdmin();
    }

    // ── SMS Logs ──────────────────────────────────────────────────────────
    // Writes come from Cloud Functions (Admin SDK bypasses rules);
    // rule below prevents direct browser writes from non-admins.
    match /smsLogs/{logId} {
      allow read:  if isActiveUser();
      allow write: if isAdmin();
    }

    // ── Fee Remittances ───────────────────────────────────────────────────────
    match /feeRemittances/{docId} {
      allow read:  if isActiveUser();
      allow write: if isAdmin();
    }

    // ── WP Fee Remittances (separate tracker for WP Fee Distribution) ──────────
    match /wpFeeRemittances/{docId} {
      allow read:  if isActiveUser();
      allow write: if isAdmin();
    }

    // ── Exam Duty Attendance Certificates (external examiners) ────────────────
    // Admin + staff issue and edit; only admin deletes. Serials are claimed in
    // counters/examCert__{session} (counters are already writable by active users).
    match /examDutyCertificates/{docId} {
      allow read, create, update: if isActiveUser();
      allow delete: if isAdmin();
    }

    // Directory of external examiners, used to auto-fill returning staff.
    match /examDutyStaff/{docId} {
      allow read, write: if isActiveUser();
    }

    // ── Setting & Conducting Certificates (external examiners) ────────────────
    // Same access as the Attendance certificates; shares their serial counter.
    match /examSettingCertificates/{docId} {
      allow read, create, update: if isActiveUser();
      allow delete: if isAdmin();
    }

    // Remembered subject codes → names, used to auto-fill the subjects table.
    match /examSubjects/{docId} {
      allow read, write: if isActiveUser();
    }

    // ── SMP Budget (planned vs actual spend per SMP fee head) ──────────────────
    match /smpBudgets/{yearId} {
      allow read:  if isActiveUser();
      allow write: if isAdmin();
    }

    // ── WP (Working Professional / Evening College) Fee Distribution ──────────
    // Manually entered admission counts per academic year, separate from smpBudgets.
    match /wpFeeDistribution/{yearId} {
      allow read:  if isActiveUser();
      allow write: if isAdmin();
    }

    // ── Cash Deposits (cash-in-hand → bank remittance tracking) ───────────────
    match /cashDeposits/{docId} {
      allow read:   if isActiveUser();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['account', 'depositDate', 'collectionDates', 'amount', 'reference']);
      allow update, delete: if isAdmin();
    }

    // ── UPI Credits (bank credit date / UTR per UPI collection day) ─────────────
    match /upiCredits/{docId} {
      allow read:   if isActiveUser();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['account', 'collectionDate', 'creditDate', 'amount']);
      allow update, delete: if isAdmin();
    }

    // ── Denomination Abstracts (Bank Remittance cash-count verification) ───────
    match /denominationAbstracts/{docId} {
      allow read:  if isActiveUser();
      allow write: if isAdmin();
    }

    // ── Exam Results (parsed from Result Ledger PDFs) ─────────────────────
    // Both admin and staff can view; students can view their own (read-only,
    // matched via regNumber — part of the student portal's academic profile).
    match /examResults/{resultId} {
      allow read: if isActiveUser()
        || (isStudentClaim() && resource.data.regNumber == request.auth.token.regNumber);
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['regNumber', 'studentName', 'examSession']);
      allow delete: if isAdmin();
    }

    // ── Login Attempts (studentLogin throttling) ──────────────────────────
    // Written only by the studentLogin Cloud Function via the Admin SDK,
    // which bypasses rules entirely — this rule blocks any direct client access.
    match /loginAttempts/{key} {
      allow read, write: if false;
    }

    // ── Daily Briefing ───────────────────────────────────────────────────────
    // `dailyQuote/{date}` is the shared quote-of-the-day the admin saves from
    // Settings › Daily Briefing (written only by the saveDailyQuote Cloud
    // Function via the Admin SDK); the panel reads the latest one directly to
    // show what students currently see. `dailyBriefing/{regNumber}` is each
    // student's personalized note+highlights cache, written only by
    // generateDailyBriefing — no direct client access at all.
    // `scholarshipUpdates/current` is the admin-published scholarship summary
    // (written only by publishScholarshipUpdates); students receive it inside
    // their briefing response, the panel reads it to show what is live.
    // Students may also *read* the quote and summary docs directly: the app
    // listens to them (like circulars) so its "new" badges flip the moment
    // the admin saves/publishes, without waiting for a briefing refetch.
    match /dailyQuote/{date} {
      allow read: if isAdmin() || isStudentClaim();
      allow write: if false;
    }
    match /dailyBriefing/{regNumber} {
      allow read, write: if false;
    }
    match /scholarshipUpdates/{docId} {
      allow read: if isAdmin() || isStudentClaim();
      allow write: if false;
    }
    // Department of Technical Education circular digest, shown on the admin
    // Dashboard. Staff read it too — departmental circulars are exactly what
    // office staff need — but no student claim, it is not student content.
    // Written only by publishDtekNews via the Admin SDK.
    match /dtekNews/{docId} {
      allow read: if isActiveUser();
      allow write: if false;
    }
    // Every circular ever published, one doc each, so older ones survive the
    // next publish replacing dtekNews/current. Also publishDtekNews-only.
    match /dtekCirculars/{docId} {
      allow read: if isActiveUser();
      allow write: if false;
    }

    // ── Student Portal Login Activity ("active users") ─────────────────────
    // Docs are created only by the studentLogin Cloud Function via the Admin SDK
    // (bypasses rules). The signed-in student may flip their own online/offline
    // status on logout — nothing else about the doc — everything else is admin/staff read-only.
    match /studentLoginActivity/{uid} {
      allow read:   if isActiveUser();
      allow update: if isStudentClaim() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['online', 'lastLogoutAt']);
      allow create, delete: if false;
    }

    // ── Notices (admin → student announcements) ───────────────────────────
    match /notices/{noticeId} {
      allow read:  if isActiveUser() || isStudentClaim();
      allow write: if isAdmin();
    }

    // ── Circulars (admin → ALL students; department is a label, not access control) ─
    match /circulars/{circularId} {
      allow read:  if isActiveUser() || isStudentClaim();
      allow write: if isAdmin();
    }

    // ── Student Circular Seen-State (unread badge) ────────────────────────
    match /studentCircularState/{regNumber} {
      allow read, write: if isActiveUser()
        || (isStudentClaim() && regNumber == request.auth.token.regNumber);
    }

    // ── Student Briefing Seen-State (Daily Briefing / Scholarship Info "new" badges) ──
    match /studentBriefingState/{regNumber} {
      allow read, write: if isActiveUser()
        || (isStudentClaim() && regNumber == request.auth.token.regNumber);
    }

    // ── Student Messages (student → admin queries) ────────────────────────
    match /studentMessages/{msgId} {
      allow read:   if isActiveUser()
        || (isStudentClaim() && resource.data.regNumber == request.auth.token.regNumber);
      allow create: if (isStudentClaim()
        && request.resource.data.regNumber == request.auth.token.regNumber
        && request.resource.data.keys().hasAll(['regNumber', 'studentName', 'category', 'message', 'status']))
        // Admins may re-create messages when restoring a backup.
        || isAdmin();
      allow update: if isActiveUser();
      allow delete: if isAdmin();
    }

    // ── Student Notice Clear-State (student self-service dismiss) ─────────
    match /studentNoticeState/{regNumber} {
      allow read, write: if isActiveUser()
        || (isStudentClaim() && regNumber == request.auth.token.regNumber);
    }


    // ── Student Push Notification Tokens (mobile app device registration) ────
    match /studentPushTokens/{regNumber} {
      allow read, write: if isActiveUser()
        || (isStudentClaim() && regNumber == request.auth.token.regNumber);
    }

    // ── Student Notifications (admin/staff → student, record-change alerts) ─
    match /studentNotifications/{id} {
      allow read:   if isActiveUser()
        || (isStudentClaim() && resource.data.regNumber == request.auth.token.regNumber);
      allow create: if isActiveUser()
        && request.resource.data.keys().hasAll(['studentId', 'regNumber', 'type', 'title', 'message', 'createdAt', 'seen']);
      allow update: if isActiveUser()
        || (isStudentClaim() && resource.data.regNumber == request.auth.token.regNumber);
      allow delete: if isAdmin();
    }
  }
}
