rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Storage Rules cannot read Firestore documents, so admin status is checked
    // via a custom Auth claim kept in sync by the syncAdminClaim Cloud Function
    // (functions/src/index.ts), which mirrors users/{uid}.role/active on write.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ── Fee Remittance soft copies (K2 challan / payment proof) ────────────
    // Payee-level: remittanceChallans/{id}/{file}; per-head (GOV): remittanceChallans/{id}/{headKey}/{file}
    match /remittanceChallans/{remittanceId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/jpeg|image/png');
    }

    // ── Circular attachments (PDF/JPEG/PNG/CSV, 5MB) ───────────────────────
    // Students never read via the SDK — they use tokenized download URLs
    // stored in the Firestore circular docs.
    match /circulars/{circularId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/jpeg|image/png|text/csv');
      allow delete: if isAdmin();
    }

    // ── Notice attachments (same limits as circulars) ──────────────────────
    match /noticeAttachments/{noticeId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/jpeg|image/png|text/csv');
      allow delete: if isAdmin();
    }

    // ── AI-generated circular background images (PNG/JPEG, 10MB) ───────────
    // Generated via the generateCircularBackground Cloud Function, then
    // uploaded here by the admin client once accepted; the resulting download
    // URL is stored on the Firestore circular doc as backgroundImageUrl.
    // 10MB (was 3MB) to accommodate higher-resolution/quality output from
    // some of the switchable image providers (e.g. OpenAI at quality 'high',
    // or Replicate/BudgetPixel models) without a storage/unauthorized reject.
    match /circularBackgrounds/{circularId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/png|image/jpeg');
      allow delete: if isAdmin();
    }

    // ── AI-generated tab header background images (PNG/JPEG, 10MB) ─────────
    // One fixed file per student-portal tab (tabHeaderBackgrounds/home.png,
    // etc.), generated via generateTabHeaderBackground and uploaded here by
    // the admin client; the download URL is stored on appConfig/tabHeaders.
    match /tabHeaderBackgrounds/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/png|image/jpeg');
      allow delete: if isAdmin();
    }

    // ── AI-generated category icon images (PNG/JPEG, 10MB) ─────────────────
    // One fixed file per Overview/Recent-Activity category
    // (categoryIcons/circulars.png, etc.), generated via generateCategoryIcon
    // and uploaded here by the admin client; the download URL is stored on
    // appConfig/categoryIcons.
    match /categoryIcons/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/png|image/jpeg');
      allow delete: if isAdmin();
    }

    // ── AI-generated Daily Briefing quote background (PNG/JPEG) ────────────
    // One shared file per calendar day (dailyQuoteBackgrounds/{date}.png),
    // written only by the generateDailyBriefing Cloud Function via the Admin
    // SDK (bypasses these rules entirely — this call originates from a
    // student's device, not the admin web client, so there's no client-side
    // upload path here). Public read: generic daily-inspiration art, nothing
    // sensitive, and it's the student app (not the admin client) reading it.
    match /dailyQuoteBackgrounds/{fileName} {
      allow read: if true;
      allow write: if false;
    }
  }
}
